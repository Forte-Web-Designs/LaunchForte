        }
      },
      "id": "kit0012-0000-4000-8000-000000000012",
      "name": "Roll back and report the delta",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        450
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// A path that is not logged cannot be improved.\nreturn [{ json: {\n  at: new Date().toISOString(),\n  key: $json.dedupeKey,\n  path: $json.outcome || 'handled',\n  ok: true,\n} }];"
      },
      "id": "kit0013-0000-4000-8000-000000000013",
      "name": "Log the run, both paths",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ received: true, handled: $json.ok === true }) }}"
      },
      "id": "kit0014-0000-4000-8000-000000000014",
      "name": "Fail safe, never guess",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        2200,
        300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 7
            }
          ]
        }
      },
      "id": "kit0015-0000-4000-8000-000000000015",
      "name": "Every Monday, 7am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        900
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $getWorkflowStaticData('global');\nconst keys = Object.entries(s.keys || {});\nconst weekAgo = Date.now() - 7 * 864e5;\nreturn [{ json: { handled: keys.filter(([,t]) => t > weekAgo).length } }];"
      },
      "id": "kit0016-0000-4000-8000-000000000016",
      "name": "Read the week of runs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        900
      ]
    },
    {
      "parameters": {
        "jsCode": "// The gap report is the part a buyer keeps paying for.\nconst handled = $json.handled || 0;\nreturn [{ json: {\n  handled,\n  note: handled === 0\n    ? 'Nothing ran this week. Worth checking the source is still sending.'\n    : `${handled} handled cleanly this week.`,\n} }];"
      },
      "id": "kit0017-0000-4000-8000-000000000017",
      "name": "Batches migrated, and anything left behind",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        900
      ]
    },
