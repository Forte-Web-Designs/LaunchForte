              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 7
            }
          ]
        }
      },
      "id": "kit0015-0000-4000-8000-000000000015",
      "name": "Every Monday, 7am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        900
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $getWorkflowStaticData('global');\nconst keys = Object.entries(s.keys || {});\nconst weekAgo = Date.now() - 7 * 864e5;\nreturn [{ json: { handled: keys.filter(([,t]) => t > weekAgo).length } }];"
      },
      "id": "kit0016-0000-4000-8000-000000000016",
      "name": "Read the week of runs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        900
      ]
    },
    {
      "parameters": {
        "jsCode": "// Records that drifted apart anyway \u2014 the ones the sync could not resolve.\nconst drift = Object.values($getWorkflowStaticData('global').drift || {});\nconst unresolved = drift.filter(d => !d.resolved);\nreturn [{ json: {\n  drifted: unresolved.length,\n  bothChanged: unresolved.filter(d => d.bothSidesChanged).length,\n  note: unresolved.length\n    ? `${unresolved.length} records disagree. Where both sides changed, a human has to pick a winner.`\n    : 'Both systems agree on every record.',\n} }];"
      },
      "id": "kit0017-0000-4000-8000-000000000017",
      "name": "Records that drifted apart anyway",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        900
