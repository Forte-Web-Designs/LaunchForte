      },
      "id": "kit0001-0000-4000-8000-000000000001",
      "name": "A record changes",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "kit0900-0000-4000-8000-000000000900"
    },
    {
      "parameters": {
        "jsCode": "// Never trust the payload.\nconst required = [\"record_id\", \"source\"];\nconst missing = required.filter(f => !$json[f]);\nreturn [{ json: { ...$json, valid: missing.length === 0, missing } }];"
      },
      "id": "kit0002-0000-4000-8000-000000000002",
      "name": "Validate what arrived",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "kit0502-0000-4000-8000-000000000502",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "kit0003-0000-4000-8000-000000000003",
      "name": "Malformed, refuse it",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// The same event arrives twice more often than anyone expects.\nconst key = $json[\"record_id\"];\nconst seen = $getWorkflowStaticData('global');\nseen.keys = seen.keys || {};\nconst isNew = !seen.keys[key];\nseen.keys[key] = Date.now();\nreturn [{ json: { ...$json, isNew, dedupeKey: key } }];"
      },
      "id": "kit0004-0000-4000-8000-000000000004",
      "name": "Deduplicate on record_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "kit0504-0000-4000-8000-000000000504",
              "leftValue": "={{ $json.isNew }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "kit0005-0000-4000-8000-000000000005",
      "name": "Already handled, stop here",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Both directions share this ceiling, so a burst on one side must not starve the other.\nconst s = $getWorkflowStaticData('global');\nconst now = Date.now();\ns.window = (s.window || []).filter(t => now - t < 60000);\nconst allowed = s.window.length < 50;\nif (allowed) s.window.push(now);\nreturn [{ json: { ...$json, allowed, ceiling: 50, inWindow: s.window.length } }];"
      },
      "id": "kit0006-0000-4000-8000-000000000006",
      "name": "Hold the rate limit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://example.com/api/mirror",
        "options": {
          "timeout": 10000
        }
      },
