{
  "name": "LF DEMO: The one page that answers it",
  "nodes": [
    {
      "parameters": {
        "path": "reporting",
        "options": {}
      },
      "id": "kit0001-0000-4000-8000-000000000001",
      "name": "A report is requested",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "kit0900-0000-4000-8000-000000000900"
    },
    {
      "parameters": {
        "jsCode": "// Never trust the payload.\nconst required = [\"period\"];\nconst missing = required.filter(f => !$json[f]);\nreturn [{ json: { ...$json, valid: missing.length === 0, missing } }];"
      },
      "id": "kit0002-0000-4000-8000-000000000002",
      "name": "Validate what arrived",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "kit0502-0000-4000-8000-000000000502",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "kit0003-0000-4000-8000-000000000003",
      "name": "Malformed, refuse it",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// The same event arrives twice more often than anyone expects.\nconst key = $json[\"period\"];\nconst seen = $getWorkflowStaticData('global');\nseen.keys = seen.keys || {};\nconst isNew = !seen.keys[key];\nseen.keys[key] = Date.now();\nreturn [{ json: { ...$json, isNew, dedupeKey: key } }];"
      },
      "id": "kit0004-0000-4000-8000-000000000004",
      "name": "Deduplicate on period",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "kit0504-0000-4000-8000-000000000504",
              "leftValue": "={{ $json.isNew }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "kit0005-0000-4000-8000-000000000005",
      "name": "Already handled, stop here",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Each run fans out across every source, so one report is many upstream calls.\nconst s = $getWorkflowStaticData('global');\nconst now = Date.now();\ns.window = (s.window || []).filter(t => now - t < 60000);\nconst allowed = s.window.length < 20;\nif (allowed) s.window.push(now);\nreturn [{ json: { ...$json, allowed, ceiling: 20, inWindow: s.window.length } }];"
      },
      "id": "kit0006-0000-4000-8000-000000000006",
      "name": "Hold the rate limit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://example.com/api/metrics",
        "options": {
          "timeout": 10000
        }
      },
      "id": "kit0007-0000-4000-8000-000000000007",
      "name": "Gather the numbers from every source",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {},
      "id": "kit0008-0000-4000-8000-000000000008",
      "name": "A source is down, say so on the page",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1540,
        620
      ]
    },
    {
      "parameters": {},
      "id": "kit0009-0000-4000-8000-000000000009",
      "name": "Escalate to a human, with the context",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1760,
        620
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "kit0509-0000-4000-8000-000000000509",
              "leftValue": "={{ $json.n >= 30 && $json.sourcesRead === $json.sourcesExpected }}",
              "rightValue": "",
