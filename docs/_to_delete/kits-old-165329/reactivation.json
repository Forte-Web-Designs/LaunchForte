    {
      "parameters": {
        "url": "https://example.com/api/message",
        "options": {
          "timeout": 10000
        }
      },
      "id": "kit0012-0000-4000-8000-000000000012",
      "name": "Leave them alone, check again later",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        450
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// A path that is not logged cannot be improved. These are the fields worth keeping for this build.\nconst s = $getWorkflowStaticData('global');\ns.runs = s.runs || {};\nconst row = { at: Date.now(), customerId: $json.customer_id, normalGapDays: $json.normalGap, sinceDays: $json.sinceDays, sent: $json.overdue };\ns.runs[$json.dedupeKey] = row;\nreturn [{ json: { ...row, ok: true } }];"
      },
      "id": "kit0013-0000-4000-8000-000000000013",
      "name": "Log the run, both paths",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ received: true, handled: $json.ok === true }) }}"
      },
      "id": "kit0014-0000-4000-8000-000000000014",
      "name": "Fail safe, never guess",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        2200,
        300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 7
            }
          ]
        }
      },
      "id": "kit0015-0000-4000-8000-000000000015",
      "name": "Every Monday, 7am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        900
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $getWorkflowStaticData('global');\nconst keys = Object.entries(s.keys || {});\nconst weekAgo = Date.now() - 7 * 864e5;\nreturn [{ json: { handled: keys.filter(([,t]) => t > weekAgo).length } }];"
      },
      "id": "kit0016-0000-4000-8000-000000000016",
      "name": "Read the week of runs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        900
      ]
    },
    {
      "parameters": {
        "jsCode": "// Dormant customers recovered \u2014 measured against each customer's own rhythm.\nconst touched = Object.values($getWorkflowStaticData('global').winbacks || {});\nconst week = touched.filter(w => w.at > Date.now() - 7*864e5);\nconst returned = week.filter(w => w.orderedSince);\nreturn [{ json: {\n  contacted: week.length,\n  returned: returned.length,\n  revenue: returned.reduce((s, w) => s + (w.orderValue || 0), 0),\n  note: week.length\n    ? `${returned.length} of ${week.length} came back. One honest message each \u2014 never a series.`\n    : 'Nobody was genuinely overdue this week.',\n} }];"
      },
      "id": "kit0017-0000-4000-8000-000000000017",
      "name": "Dormant customers recovered",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        900
      ]
    },
