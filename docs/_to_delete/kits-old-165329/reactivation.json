      "typeVersion": 2.2,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://example.com/api/message",
        "options": {
          "timeout": 10000
        }
      },
      "id": "kit0011-0000-4000-8000-000000000011",
      "name": "Send one win-back, never a series",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        150
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
