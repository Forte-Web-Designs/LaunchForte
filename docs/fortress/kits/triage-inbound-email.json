    {
      "id": "b92b9ca2-0663-4de9-9d24-08109d165cf1",
      "name": "Ask Claude to triage",
      "type": "@n8n/n8n-nodes-langchain.anthropic",
      "typeVersion": 1,
      "position": [-200, 140],
      "parameters": {
        "resource": "text",
        "operation": "message",
        "modelId": { "mode": "id", "value": "claude-sonnet-4-5-20250929" },
        "messages": { "values": [ { "content": "=Subject: {{ $json.subject || $json.Subject || '(no subject)' }}\nFrom: {{ $json.from || $json.From || '(unknown sender)' }}\n\nBody (first 1500 characters):\n{{ (($json.text || $json.textPlain || $json.snippet || '') + '').slice(0, 1500) }}", "role": "user" } ] },
        "simplify": true,
        "options": {
          "system": "You are an inbound email triage assistant. Read the subject and the body excerpt and respond with STRICT JSON only -- no markdown, no code fences, no commentary before or after. The JSON object must have exactly these keys: summary (one sentence), category (one of: client, sales, vendor, notification, spam), urgent (boolean), needs_reply (boolean), draft (a short reply if needs_reply is true, otherwise an empty string). Output only the JSON object and nothing else.",
          "maxTokens": 500,
          "temperature": 0,
          "includeMergedResponse": true
        }
      },
      "credentials": { "anthropicApi": { "id": "UzSqXhbmbxLh09m6", "name": "Anthropic" } }
    },
    {
      "id": "07f47ad7-4bb9-4ac7-89e3-0c5a80dadc08",
      "name": "Read the triage",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [40, 140],
      "parameters": {
        "mode": "runOnceForEachItem",
        "language": "javaScript",
        "jsCode": "const mail = $('Fetch recent mail').item.json;\n\nfunction extractText(json) {\n  if (typeof json.content === 'string') return json.content;\n  if (Array.isArray(json.content)) {\n    return json.content.filter(b => b && b.type === 'text').map(b => b.text).join('\\n');\n  }\n  if (typeof json.text === 'string') return json.text;\n  if (json.message && typeof json.message.content === 'string') return json.message.content;\n  return JSON.stringify(json);\n}\n\nconst raw = extractText($json);\nlet parsed = null;\ntry {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  parsed = JSON.parse(match ? match[0] : raw);\n} catch (e) {\n  parsed = null;\n}\n\nconst validCategories = ['client', 'sales', 'vendor', 'notification', 'spam'];\n\nconst triage = {\n  summary: parsed && typeof parsed.summary === 'string' ? parsed.summary : 'Could not parse a summary from the model output.',\n  category: parsed && validCategories.includes(parsed.category) ? parsed.category : 'unknown',\n  urgent: parsed && typeof parsed.urgent === 'boolean' ? parsed.urgent : false,\n  needs_reply: parsed && typeof parsed.needs_reply === 'boolean' ? parsed.needs_reply : false,\n  draft: parsed && typeof parsed.draft === 'string' ? parsed.draft : '',\n  raw_triage_text: raw,\n};\n\nreturn {\n  json: {\n    ...triage,\n    messageId: mail.id,\n    threadId: mail.threadId,\n    from: mail.from || mail.From || '(unknown sender)',\n    subject: mail.subject || mail.Subject || '(no subject)',\n  },\n};"
      }
    },
