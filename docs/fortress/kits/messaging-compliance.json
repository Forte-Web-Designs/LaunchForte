      "id": "kit0012-0000-4000-8000-000000000012",
      "name": "Hold it and tell the owner what is missing",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        450
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// A path that is not logged cannot be improved. These are the fields worth keeping for this build.\nconst s = $getWorkflowStaticData('global');\ns.runs = s.runs || {};\nconst row = { at: Date.now(), messageId: $json.message_id, brandId: $json.brand_id, channel: $json.channel, registered: $json.registered, held: $json.held || false };\ns.runs[$json.dedupeKey] = row;\nreturn [{ json: { ...row, ok: true } }];"
      },
      "id": "kit0013-0000-4000-8000-000000000013",
      "name": "Log the run, both paths",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ received: true, handled: $json.ok === true }) }}"
      },
      "id": "kit0014-0000-4000-8000-000000000014",
      "name": "Fail safe, never guess",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        2200,
        300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 7
            }
          ]
        }
      },
      "id": "kit0015-0000-4000-8000-000000000015",
      "name": "Every Monday, 7am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        900
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $getWorkflowStaticData('global');\nconst keys = Object.entries(s.keys || {});\nconst weekAgo = Date.now() - 7 * 864e5;\nreturn [{ json: { handled: keys.filter(([,t]) => t > weekAgo).length } }];"
      },
      "id": "kit0016-0000-4000-8000-000000000016",
      "name": "Read the week of runs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        900
      ]
    },
    {
      "parameters": {
        "jsCode": "// Which brands are registered, and which are drifting \u2014 before a carrier decides for us.\nconst ids = Object.values($getWorkflowStaticData('global').identities || {});\nconst unregistered = ids.filter(i => !i.registered);\nconst unauth = ids.filter(i => i.channel === 'email' && !(i.spf && i.dkim && i.dmarc));\nconst expiring = ids.filter(i => i.registered && i.renewsInDays != null && i.renewsInDays <= 30);\nreturn [{ json: {\n  identities: ids.length,\n  unregistered: unregistered.map(i => i.brand),\n  missingAuth: unauth.map(i => i.brand),\n  expiringSoon: expiring.map(i => `${i.brand} (${i.renewsInDays}d)`),\n  note: unregistered.length || unauth.length\n    ? `${[...unregistered, ...unauth].map(i => i.brand).join(', ')} are sending without full clearance. 10DLC filtering is silent \u2014 you find out from the reply rate, not an error.`\n    : expiring.length\n      ? `${expiring.length} registrations renew inside 30 days. Renew before the campaign, not during it.`\n      : 'Every sending identity is registered and authenticated.',\n} }];"
      },
      "id": "kit0017-0000-4000-8000-000000000017",
      "name": "Which brands are registered, and which are drifting",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        900
      ]
    },
