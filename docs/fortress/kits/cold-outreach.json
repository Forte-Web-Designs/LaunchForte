{
  "name": "LF DEMO: The outreach that protects the domain",
  "nodes": [
    {
      "parameters": {
        "path": "cold-outreach",
        "options": {}
      },
      "id": "kit0001-0000-4000-8000-000000000001",
      "name": "A campaign step is due",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        0,
        300
      ],
      "webhookId": "kit0900-0000-4000-8000-000000000900"
    },
    {
      "parameters": {
        "jsCode": "// Never trust the payload.\nconst required = [\"lead_id\", \"step\"];\nconst missing = required.filter(f => !$json[f]);\nreturn [{ json: { ...$json, valid: missing.length === 0, missing } }];"
      },
      "id": "kit0002-0000-4000-8000-000000000002",
      "name": "Validate what arrived",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "kit0502-0000-4000-8000-000000000502",
              "leftValue": "={{ $json.valid }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "kit0003-0000-4000-8000-000000000003",
      "name": "Malformed, refuse it",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        440,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// The same event arrives twice more often than anyone expects.\nconst key = $json[\"lead_id\"];\nconst seen = $getWorkflowStaticData('global');\nseen.keys = seen.keys || {};\nconst isNew = !seen.keys[key];\nseen.keys[key] = Date.now();\nreturn [{ json: { ...$json, isNew, dedupeKey: key } }];"
      },
      "id": "kit0004-0000-4000-8000-000000000004",
      "name": "Deduplicate on lead_id",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "kit0504-0000-4000-8000-000000000504",
              "leftValue": "={{ $json.isNew }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "kit0005-0000-4000-8000-000000000005",
      "name": "Already handled, stop here",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Sending pace IS the deliverability strategy \u2014 a high ceiling burns the domain.\nconst s = $getWorkflowStaticData('global');\nconst now = Date.now();\ns.window = (s.window || []).filter(t => now - t < 60000);\nconst allowed = s.window.length < 15;\nif (allowed) s.window.push(now);\nreturn [{ json: { ...$json, allowed, ceiling: 15, inWindow: s.window.length } }];"
      },
      "id": "kit0006-0000-4000-8000-000000000006",
      "name": "Hold the rate limit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://example.com/api/verify",
        "options": {
          "timeout": 10000
        }
      },
      "id": "kit0007-0000-4000-8000-000000000007",
      "name": "Verify the address before spending reputation on it",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        300
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {},
      "id": "kit0008-0000-4000-8000-000000000008",
      "name": "Verifier down, hold the send rather than risk the domain",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1540,
        620
      ]
    },
    {
      "parameters": {},
      "id": "kit0009-0000-4000-8000-000000000009",
      "name": "Escalate to a human, with the context",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1760,
        620
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "kit0509-0000-4000-8000-000000000509",
              "leftValue": "={{ $json.deliverable === true && $json.replied !== true && $json.step <= 3 }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "kit0010-0000-4000-8000-000000000010",
      "name": "Safe to send, and have they stayed quiet?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1540,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://example.com/api/send",
        "options": {
          "timeout": 10000
        }
      },
      "id": "kit0011-0000-4000-8000-000000000011",
      "name": "Send the next step",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        150
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "url": "https://example.com/api/send",
        "options": {
          "timeout": 10000
        }
      },
      "id": "kit0012-0000-4000-8000-000000000012",
      "name": "Stop the sequence, hand to a human",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1760,
        450
      ],
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "// A path that is not logged cannot be improved. These are the fields worth keeping for this build.\nconst s = $getWorkflowStaticData('global');\ns.runs = s.runs || {};\nconst row = { at: Date.now(), leadId: $json.lead_id, step: $json.step, deliverable: $json.deliverable, replied: $json.replied };\ns.runs[$json.dedupeKey] = row;\nreturn [{ json: { ...row, ok: true } }];"
      },
      "id": "kit0013-0000-4000-8000-000000000013",
      "name": "Log the run, both paths",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1980,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ received: true, handled: $json.ok === true }) }}"
      },
      "id": "kit0014-0000-4000-8000-000000000014",
      "name": "Fail safe, never guess",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [
        2200,
        300
      ]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "weeks",
              "triggerAtDay": [
                1
              ],
              "triggerAtHour": 7
            }
          ]
        }
      },
      "id": "kit0015-0000-4000-8000-000000000015",
      "name": "Every Monday, 7am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        900
      ]
    },
    {
      "parameters": {
        "jsCode": "const s = $getWorkflowStaticData('global');\nconst keys = Object.entries(s.keys || {});\nconst weekAgo = Date.now() - 7 * 864e5;\nreturn [{ json: { handled: keys.filter(([,t]) => t > weekAgo).length } }];"
      },
      "id": "kit0016-0000-4000-8000-000000000016",
      "name": "Read the week of runs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        220,
        900
      ]
    },
    {
      "parameters": {
        "jsCode": "// Bounce rate and reply rate, before the domain pays for it.\nconst sends = Object.values($getWorkflowStaticData('global').sends || {});\nconst week = sends.filter(s => s.at > Date.now() - 7*864e5);\nconst bounced = week.filter(s => s.bounced);\nconst replied = week.filter(s => s.replied);\nconst bounceRate = week.length ? (bounced.length / week.length * 100) : 0;\nreturn [{ json: {\n  sent: week.length,\n  bounceRate: Math.round(bounceRate * 10) / 10,\n  replyRate: week.length ? Math.round(replied.length / week.length * 1000) / 10 : 0,\n  note: bounceRate > 3\n    ? `Bounce rate ${bounceRate.toFixed(1)}% \u2014 above 3% the domain starts paying for it. Pause and reverify the list.`\n    : 'Bounce rate is inside a safe band. Keep the pace.',\n} }];"
      },
      "id": "kit0017-0000-4000-8000-000000000017",
      "name": "Bounce rate and reply rate, before the domain pays for it",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        900
      ]
    },
    {
      "parameters": {},
      "id": "kit0018-0000-4000-8000-000000000018",
      "name": "Weekly gap report to the owner",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        660,
        900
      ]
    }
